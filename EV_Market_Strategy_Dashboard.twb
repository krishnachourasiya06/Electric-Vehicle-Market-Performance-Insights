      <style />
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='4357' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone h='10477' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='5187' />
            <zone h='83506' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='15664'>
              <flipboard active-id='8' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Battery adoption: LFP and NMC account for the largest sales totals in this dataset.' captured-sheet='Battery Technology Adoption' id='1' />
                  <story-point caption='Category sales vary widely; hatchbacks, sedans, and two-wheelers lead the reported totals.' captured-sheet='Category Sales' id='2' />
                  <story-point caption='Average customer ratings are tightly clustered near 4 across vehicle categories.' captured-sheet='Customer Satisfaction by Category' id='3' />
                  <story-point caption='Executive overview: compare battery sales, category sales, and customer ratings in one view.' captured-sheet='EV Executive Dashboard' id='4' />
                  <story-point caption='Manufacturing distribution spans multiple regions; use the map to compare country locations and sales.' captured-sheet='Sheet 5' id='5' />
                  <story-point caption='Manufacturer sales share: use the pie and filter to compare manufacturers; the largest share identifies the sales leader.' captured-sheet='Sheet 8' id='6' />
                  <story-point caption='Yearly sales totals fluctuate; after a dip around 2021, totals recover before easing in the latest displayed year.' captured-sheet='Sheet 7' id='7' />
                  <story-point caption='Average driving range varies across categories and battery types; luxury and full-size segments trend higher in this view.' captured-sheet='Sheet 6' id='8' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#444444' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{D77D76FB-5217-48A4-9DAC-1B691A005691}' />
    </dashboard>
